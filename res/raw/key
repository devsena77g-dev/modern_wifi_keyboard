<h1>WiFi&nbsp;Keyboard</h1>
  <table border="0"><tbody><tr><td>
  <h2>Mode:</h2>
  <div class="mode"><font color="green"><b>Instant Typing Mode (Active)</b></font></div>
  </td></tr></tbody></table>
</td>
<td width="450">
  <table border="0"><tbody><tr><td>
  <h2>Status Info:</h2>
  <ul>
  <li><font color="green">F4 requirement bypassed</font></li>
  <li>Direct keystroke streaming enabled</li>
  </ul>
  </td></tr></tbody></table>
</td>
<td align="right" width="200">
<!-- Side bar -->
  <table border="1" cellpadding="20"><tbody><tr><td>
