  <div class="mode"><input type="radio" name="mode" value="i" checked>International keyboard</div>
  <div class="mode"><input type="radio" name="mode" value="c">Game mode (key codes only)</div>
  </form>
  </td></tr></tbody></table>

<!-- Main Window End -->
</td>
<td width="450">
  <table border="0"><tbody><tr><td>
