<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
  <title>WiFi Keyboard</title>
  <script language="JavaScript">
   if (typeof XMLHttpRequest == "undefined")
     XMLHttpRequest = function () {
       try { return new ActiveXObject("Msxml2.XMLHTTP.6.0"); }
       catch (e) {}
       try { return new ActiveXObject("Msxml2.XMLHTTP.3.0"); }
       catch (e) {}
       try { return new ActiveXObject("Msxml2.XMLHTTP"); }
       catch (e) {}
       throw new Error("This browser does not support XMLHttpRequest.");
   };

    seqConfirmed = 12345;
    seqPressed = seqConfirmed;
    events = Object();
    num_inflight = 0;
    num_delayed = 0;
    displayState = "loading";
    stat = null;

    function onConfirm(newConfirmed) {
      if (newConfirmed == seqPressed) {
        events = Object();
      }
      if (newConfirmed <= seqConfirmed) return;
      for (i = seqConfirmed; i < newConfirmed; i++) {
        events[i] = undefined;
      }
      seqConfirmed = newConfirmed;
      network();
    }

    function queue(code, mode) {
      ev = mode + code;
      events[seqPressed] = ev;
      seqPressed += 1;
    }

    function send(code, mode) {
      queue(code, mode);
      network();
    }

    function makeXhr() {
      var xhr = new XMLHttpRequest();
      var sentNewConfirmed = newConfirmed;
      var aborted = false;
      var finished = false;
      num_inflight += 1;
      xhr.onreadystatechange = function() {
        if (aborted) return;
        if (xhr.readyState != 4) return;
        num_inflight -= 1;
        finished = true;

        if (xhr.status != 200) {
          setDisplayState("failure");
          if (num_delayed == 0) {
            num_delayed = 1;
            setTimeout("networkDelayed();", 2000);
          }
          return;
        }
        setDisplayState("connected");
        onConfirm(sentNewConfirmed);
      }
      setTimeout(function() {
        if (finished) return;
        aborted = true;
        xhr.abort();
        num_inflight -= 1;
        setDisplayState("failure");
        makeXhr();
      }, 3000);
      xhr.open('GET', "/key?" + sentNewConfirmed + "," + data, true);
      xhr.send(null);
      return xhr;
    }

    function network() {
      if (seqConfirmed == seqPressed) return;
      if (num_inflight > 0) return;

      charsToTransmit = seqPressed - seqConfirmed;
      if (charsToTransmit > 100) charsToTransmit = 100;
      data = events[seqConfirmed] + ",";
      newConfirmed = seqConfirmed + charsToTransmit;
      for (i = seqConfirmed + 1; i < newConfirmed; i++) {
        data = events[i] + "," + data;
      }
      makeXhr();
    }

    function networkDelayed() {
      num_delayed = 0;
      network();
    }

    // Direct Instant Key Handlers (Bypassing legacy buffering)
    function handleKeyDown(e) {
      if (!e) e = window.event;
      var code = e.keyCode || e.which;
      
      if (code === 8) { // Backspace
        send(8, 'D');
        send(8, 'U');
        if (e.preventDefault) e.preventDefault();
      } else if (code === 13) { // Enter
        send(13, 'D');
        send(13, 'U');
        if (e.preventDefault) e.preventDefault();
      }
    }

    function handleKeyPress(e) {
      if (!e) e = window.event;
      var ch = e.charCode || e.keyCode;
      if (ch !== 0 && ch !== 8 && ch !== 13) {
        send(ch, 'C'); // Stream character code instantly
      }
      var x = document.getElementById("in");
      if (x) x.value = "";
      if (e.preventDefault) e.preventDefault();
      return false;
    }

    function setDisplayState(newState) {
      if (newState == displayState) return;
      displayState = newState;

      if (stat == null) {
        stat = document.getElementById("status");
        xcomment = document.getElementById("comment");
      }
      if (stat == null) return;

      if (newState == "connected") {
        stat.innerHTML = "Connected";
        stat.style.color = "green";
        xcomment.innerHTML = "Instant typing active. No F4 required.";
      } else if (newState == "failure") {
        stat.innerHTML = "Connection problem";
        stat.style.color = "red";
        xcomment.innerHTML = "No connection between the phone and computer.";
      }
    }

    function loadFinished() {
      var x = document.getElementById("in");
      if (x) {
        x.focus();
        x.onkeydown = handleKeyDown;
        x.onkeypress = handleKeyPress;
        x.value = "";
        x.style.backgroundColor = "#f1f1ed";
      }
      
      send(1024, 'D');

      // Continuous focus lock loop to keep typing active seamlessly
      setInterval(function() {
        var inputEl = document.getElementById("in");
        if (inputEl && document.activeElement !== inputEl) {
          inputEl.focus();
        }
      }, 300);
    }
    window.onload = loadFinished;
</script>
